{
  "$comment": "claude-switch's own model prices, layered over LiteLLM and models.dev when it estimates local Claude Code and Codex spend. It carries prices those lists don't have yet, fast-mode multipliers they omit, and alias rules that map the model names in session logs to their price keys. The app bundles this file and fetches it from https://claude-switch.shizue.net/pricing-supplement.json about once an hour, so a change here reaches installed apps once the site deploys. Rates are USD per million tokens. Sources: https://platform.claude.com/docs/en/about-claude/pricing and https://developers.openai.com/api/docs/pricing.",
  "updated_at": "2026-10-17T00:00:00Z",
  "pricing": {
    "claude-opus-4-7-fast": {
      "$comment": "Opus 4.7 fast mode, for model names that carry a -fast suffix. models.dev carries higher, stale numbers, so this entry wins.",
      "input_per_million": 30.0,
      "cache_write_per_million": 37.5,
      "cache_read_per_million": 3.0,
      "output_per_million": 150.0
    },
    "claude-opus-4-8-fast": {
