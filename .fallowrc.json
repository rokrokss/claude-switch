{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreExports": [
    // shadcn primitives: kept identical to `shadcn add` output, so unused sub-parts are expected.
    { "file": "apps/claude-switch/src/design/ui/**", "exports": ["*"] }
  ],
  "boundaries": {
    "zones": [
      { "name": "design", "patterns": ["apps/claude-switch/src/design/**"] },
      {
        "name": "app",
        "patterns": [
          "apps/claude-switch/src/components/**",
          "apps/claude-switch/src/features/**",
          "apps/claude-switch/src/lib/**",
          "apps/claude-switch/src/test/**",
          "apps/claude-switch/src/*.{ts,tsx}"
        ]
      }
    ],
    "rules": [
      // The design module is closed so it can later move to packages/ as-is.
      { "from": "design", "allow": [] },
      { "from": "app", "allow": ["design"] }
    ]
  }
}
